# 复制为 /etc/sp/sp.env，chmod 600、chown root:root
# systemd 以 root 读取该文件后再降权运行，密码不进入进程命令行

# 生产环境：读取 appsettings.Production.json，未显式设置监听时用它兜底
ASPNETCORE_ENVIRONMENT=Production

# 只监听本机，由 Nginx 反代；要直接对外访问改成 http://0.0.0.0:7788
ASPNETCORE_URLS=http://127.0.0.1:7788

# 信任 Nginx 传来的 X-Forwarded-For / X-Forwarded-Proto（验证码限流按真实 IP）
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# 数据目录必须在 ReadWritePaths 内（sp.service 里已写 /var/lib/sp）
ConnectionStrings__Db="Data Source=/var/lib/sp/sp.db"

# Data Protection 密钥环：用于解密数据库里的 SMTP 密码与提供商密钥
# 换机器或删掉它，后台保存的密文全部失效，需要重新录入
Security__KeysPath=/var/lib/sp/keys

# 仅在管理员表为空时创建初始账号；建好后可以删掉这两行，改密码在后台做
Admin__InitialUsername=admin
Admin__InitialPassword=请换成至少8位的密码

# 应急总钥匙（X-Admin-Key），建议随机 64 位；不需要应急入口就留空
Admin__Key=

# 邮件建议登录后台「服务器配置」填写（加密存储，保存即生效）。
# 下面这些环境变量优先级更高，只在自动化部署时使用；填了就覆盖后台值。
# Email__Enabled=true
# Email__Host=smtp.qq.com
# Email__Port=465
# Email__UseImplicitTls=true
# Email__User=you@example.com
# Email__Password=邮箱授权码
# Email__From=you@example.com
# Email__FromName=SP 助手

# 上游模型密钥：环境变量优先于后台 KeyEnv；也可以全部在后台「KeyEnv 管理」里配
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# ZHIPU_API_KEY=
# QIANFAN_API_KEY=
# SILICONFLOW_API_KEY=
