# ================================
# 项目根目录 .gitignore
# 四个子项目共享规则；各子项目专属规则写在各子目录自己的 .gitignore
# ================================

# ---- 操作系统 ----
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
.AppleDouble
.LSOverride
Icon
# ---- Node.js ----
web/node_modules/
deploy/dist/
admin/node_modules/
admin/dist/
admin/dist-nginx/
server/wwwroot/admin/
server/out/
*.tsbuildinfo
.workbuddy/


## .NET 隐藏文件夹
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# ---- 编辑器 / IDE ----
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.vcxproj.user
*.swp
*.swo
*~
.history
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# ---- 日志与临时文件 ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.bak
*.old
*.cache

# ---- 环境变量与本地配置 ----

.env.local
.env.development.local
.env.test.local
.env.production.local
*.local.json
appsettings.Local.json
appsettings.*.json
!appsettings.json
!appsettings.Development.json
!appsettings.Production.json


# ---- 证书与密钥 ----
*.pem
*.key
*.crt
*.pfx
*.cer
# Data Protection 密钥环：可解密数据库中的提供商密钥，只保留在服务器上
server/keys/
server/src/keys/
/keys/
# 验证脚本用临时目录启动服务时生成的密钥环
tests-web/**/keys/

# ---- 压缩与备份 ----
*.7z
*.zip
*.rar
*.tar
*.gz
*.tgz
*.bak

# ---- 数据库文件（开发 SQLite 按需排除，若要保留种子请注释下面两行） ----
*.db
*.db-shm
*.db-wal
# *.sqlite
# *.sqlite3

# ---- server/ .NET 编译产物（含 dotnet 复制到 bin 的 data 目录副本） ----
server/[Bb]in/
server/[Oo]bj/
server/src/[Bb]in/
server/src/[Oo]bj/
server/src/out/
server/tests/**/[Bb]in/
server/tests/**/[Oo]bj/
server/src/tests/**/[Bb]in/
server/src/tests/**/[Oo]bj/

# ---- Python 缓存 ----
__pycache__/
*.py[cod]