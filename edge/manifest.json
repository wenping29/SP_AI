{
  "manifest_version": 3,
  "name": "SP AI助手",
  "version": "0.1.0",
  "description": "网页总结与划词 AI 工具，支持切换国产大模型，积分制计费",
  "permissions": ["sidePanel", "storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shared/extract.js", "content/page.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "打开 SP 侧边栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
